# AI API Keys — DO NOT COMMIT (excluded by .gitignore)

# OpenCode API key (default provider — DeepSeek, Grok, GLM and others via opencode.ai)
OPENCODE_API_KEY=

# Gemini API key (alternative to OpenCode)
GEMINI_API_KEY=

# GigaChat API key (alternative to OpenCode/Gemini)
GIGACHAT_API_KEY=

# OpenRouter API key (alternative to OpenCode/Gemini/GigaChat — aggregates multiple models)
OPENROUTER_API_KEY=

# PostgreSQL credentials
POSTGRES_USER=assessment
POSTGRES_PASSWORD=assessment

# Admin credentials (read from env at runtime, NOT stored in DB)
# To generate hash: use Spring Security BCryptPasswordEncoder
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH={bcrypt}$$2a$$12$$3bgslYyY8l4jFEUHSNTsxe53SzKCU93CuHf.fFF4MaVTlK1RBATR2

# HMAC secret for employee invite tokens (change in production!)
HMAC_SECRET=change-me-in-production
