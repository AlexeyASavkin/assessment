<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- competencies -->
    <changeSet id="1" author="assessment">
        <createTable tableName="competencies">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="now()"/>
        </createTable>
    </changeSet>

    <!-- criteria -->
    <changeSet id="2" author="assessment">
        <createTable tableName="criteria">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="competency_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_criteria_competency"
                             referencedTableName="competencies" referencedColumnNames="id"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="weight" type="DECIMAL(3,2)" defaultValueNumeric="1.0"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="now()"/>
        </createTable>
    </changeSet>

    <!-- criteria_levels -->
    <changeSet id="3" author="assessment">
        <createTable tableName="criteria_levels">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="criteria_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_levels_criteria"
                             referencedTableName="criteria" referencedColumnNames="id"/>
            </column>
            <column name="level" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="requirements" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="now()"/>
        </createTable>
    </changeSet>

    <!-- employees -->
    <changeSet id="4" author="assessment">
        <createTable tableName="employees">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="full_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="position" type="VARCHAR(255)"/>
            <column name="department" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="now()"/>
        </createTable>
    </changeSet>

    <!-- sessions (BEFORE assessment_invite_tokens!) -->
    <changeSet id="5" author="assessment">
        <createTable tableName="sessions">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="employee_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_sessions_employee"
                             referencedTableName="employees" referencedColumnNames="id"/>
            </column>
            <column name="status" type="VARCHAR(50)" defaultValue="ACTIVE"/>
            <column name="current_question_id" type="UUID"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="now()"/>
        </createTable>
    </changeSet>

    <!-- assessment_invite_tokens -->
    <changeSet id="6" author="assessment">
        <createTable tableName="assessment_invite_tokens">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="token_hash" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="employee_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_tokens_employee"
                             referencedTableName="employees" referencedColumnNames="id"/>
            </column>
            <column name="session_id" type="UUID">
                <constraints foreignKeyName="fk_tokens_session"
                             referencedTableName="sessions" referencedColumnNames="id"/>
            </column>
            <column name="used" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="used_at" type="TIMESTAMP"/>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()"/>
        </createTable>
    </changeSet>

    <!-- question_attempts -->
    <changeSet id="7" author="assessment">
        <createTable tableName="question_attempts">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"/>
            </column>
            <column name="session_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_attempts_session"
                             referencedTableName="sessions" referencedColumnNames="id"/>
            </column>
            <column name="question_text" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="raw_transcript" type="TEXT"/>
            <column name="final_transcript" type="TEXT"/>
            <column name="score" type="DECIMAL(3,2)"/>
            <column name="confidence" type="VARCHAR(20)"/>
            <column name="valid_judge" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="feedback" type="TEXT"/>
            <column name="followup_depth" type="INTEGER" defaultValueNumeric="0"/>
            <column name="followup_parent_id" type="UUID">
                <constraints foreignKeyName="fk_attempts_parent"
                             referencedTableName="question_attempts" referencedColumnNames="id"/>
            </column>
            <column name="criteria_id" type="UUID">
                <constraints foreignKeyName="fk_attempts_criteria"
                             referencedTableName="criteria" referencedColumnNames="id"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()"/>
        </createTable>
    </changeSet>

    <!-- Performance indexes -->
    <changeSet id="8" author="assessment">
        <createIndex tableName="question_attempts" indexName="idx_attempts_session">
            <column name="session_id"/>
        </createIndex>
        <createIndex tableName="question_attempts" indexName="idx_attempts_criteria">
            <column name="criteria_id"/>
        </createIndex>
        <createIndex tableName="question_attempts" indexName="idx_attempts_parent">
            <column name="followup_parent_id"/>
        </createIndex>
        <createIndex tableName="assessment_invite_tokens" indexName="idx_tokens_hash">
            <column name="token_hash"/>
        </createIndex>
        <createIndex tableName="assessment_invite_tokens" indexName="idx_tokens_employee">
            <column name="employee_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
